# Build files
.gradle
.kotlin
build
app/.cxx/
.cxx/

# IDE files
*.iml
.idea/*
!.idea/icon.svg
/captures

# Configuration files (may contain local machine paths / secrets)
keystore.properties
local.properties
local.properties.bak
*.bak

# Local backup / scratch directories
# ⚠️ 必须带前导 / 锚定到仓库根：无锚定的 `backup/` 会匹配任意层级的同名目录，
# 把源码目录 app/src/main/java/eu/kanade/tachiyomi/data/backup/ 一起吞掉。
# 已跟踪的文件不受影响，但**在该目录下新建文件会被 git 静默忽略** ——
# BackupCredentialGuard.kt 与 BackupSavedSearch.kt 就是这么丢的，
# 于是干净检出编不过（:app 有 28 个级联的 Unresolved reference）。
/_backup_*/
/backup/
/tmp/

# Logs
*.log

# Android / OS noise
*.apk
*.aab
.DS_Store
Thumbs.db
